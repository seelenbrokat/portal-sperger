# Timocom API (Pflicht)
TIMOCOM_USERNAME=
TIMOCOM_PASSWORD=
TIMOCOM_BASE_URL=https://api.timocom.com/freight-exchange/3

# Suche
SEARCH_INTERVAL_MINUTES=30
MAX_RESULTS=30
DATA_DIR=data
TIMEZONE=Europe/Berlin

# Routen (leer = alle)
# ROUTES=ulm_vorarlberg,vorarlberg_schweiz,schweiz_vorarlberg,schweiz_oesterreich
ORIGIN_COUNTRY=DE
ORIGIN_CITY=Ulm
ORIGIN_POSTAL_CODE=89073
ORIGIN_RADIUS_KM=30
# Augsburg separat (nicht im Ulm-30-km-Kreis; ~75 km entfernt)
AUGSBURG_COUNTRY=DE
AUGSBURG_CITY=Augsburg
AUGSBURG_POSTAL_CODE=86150
AUGSBURG_RADIUS_KM=30
DEST_POSTAL_PREFIXES=67,68,69
CH_AT_MAX_LENGTH_M=6

# Tagesmail 18:00 Europe/Berlin (optional)
SUMMARY_HOUR=18
SUMMARY_MINUTE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
MAIL_TO=

# Filter-API (Ausblenden / Watchlist) – nur localhost, Nginx proxied /api/
WEB_API_ENABLED=true
WEB_API_HOST=127.0.0.1
WEB_API_PORT=3120
